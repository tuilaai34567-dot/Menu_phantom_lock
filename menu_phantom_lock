<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    <title>PHANTOM AURA LOCK</title>
    <link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@400;700;900&family=Rajdhani:wght@400;500;600;700&family=JetBrains+Mono:wght@400;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
    <style>
        * { margin:0; padding:0; box-sizing:border-box; -webkit-tap-highlight-color:transparent; }
        body {
            background:#050505; color:#e0e0e0; font-family:'Rajdhani', sans-serif;
            min-height:100vh; display:flex; justify-content:center; align-items:center;
            padding:14px; position:relative; overflow-x:hidden;
            -webkit-font-smoothing: antialiased;
        }
        /* ===== BACKGROUND JOKER - RẤT MỜ ===== */
        body::before {
            content:''; position:fixed; inset:0;
            background-image: url('https://wallpapercave.com/wp/wp1818081.jpg');
            background-size: cover; background-position: center;
            background-repeat: no-repeat;
            opacity: 0.05;
            filter: grayscale(80%) blur(6px) brightness(0.7) contrast(1.1);
            z-index: -2; pointer-events: none;
        }
        body::after {
            content:''; position:fixed; inset:0;
            background: radial-gradient(circle at 50% 30%, rgba(0,0,0,0.6), rgba(0,0,0,0.97) 80%);
            z-index: -1; pointer-events: none;
        }
        .container {
            max-width:480px; width:100%;
            background: linear-gradient(160deg, rgba(15,2,2,0.75), rgba(25,4,4,0.8));
            border-radius:32px; padding:18px 14px;
            border:1px solid rgba(255,40,40,0.4);
            box-shadow:
                0 20px 60px rgba(0,0,0,0.95),
                0 0 40px rgba(220,20,20,0.25),
                0 0 80px rgba(220,20,20,0.15),
                0 0 120px rgba(220,20,20,0.08),
                inset 0 1px 0 rgba(255,255,255,0.06),
                inset 0 -1px 0 rgba(255,40,40,0.2);
            position:relative; overflow:hidden;
            -webkit-backdrop-filter: blur(24px) saturate(180%);
            backdrop-filter: blur(24px) saturate(180%);
        }
        .container::before {
            content:''; position:absolute; top:-50%; left:-50%; width:200%; height:200%;
            background: radial-gradient(circle at 30% 10%, rgba(220,30,30,0.18), transparent 45%);
            pointer-events:none; z-index:0;
        }
        .glow-top {
            position:absolute; top:0; left:0; right:0; height:2px;
            background:linear-gradient(90deg, transparent, #ff2222, #ff5555, #ff2222, transparent);
            filter:blur(1px); z-index:2;
            animation: topGlow 3s ease-in-out infinite;
        }
        @keyframes topGlow { 0%,100% { opacity:0.7; } 50% { opacity:1; } }
        .header {
            display:flex; justify-content:space-between; align-items:center;
            margin-bottom:14px; position:relative; z-index:1;
        }
        .logo {
            font-family:'Orbitron', monospace; font-size:17px; font-weight:900; letter-spacing:1px;
            color:#ff3333; text-shadow: 0 0 30px rgba(255,30,30,0.6), 0 0 60px rgba(255,30,30,0.3);
        }
        .logo span { font-weight:400; color:#7a3a3a; font-size:10px; }
        .status {
            display:flex; align-items:center; gap:5px;
            background:rgba(255,40,40,0.12); padding:4px 12px 4px 8px; border-radius:30px;
            border:1px solid rgba(255,40,40,0.35); font-size:8px; font-weight:700; color:#cc5555;
            text-transform:uppercase; letter-spacing:0.5px;
            box-shadow: 0 0 15px rgba(255,30,30,0.15);
        }
        .status .dot {
            width:6px; height:6px; border-radius:50%; background:#ff2222;
            box-shadow: 0 0 12px rgba(255,30,30,0.9), 0 0 20px rgba(255,30,30,0.5);
            animation:pulse 1.8s ease-in-out infinite;
        }
        @keyframes pulse { 0%,100%{opacity:1;transform:scale(1)} 50%{opacity:0.4;transform:scale(0.8)} }

        .tab-nav {
            display:flex; gap:3px; margin:0 0 14px; position:relative; z-index:1;
            background:rgba(0,0,0,0.5); border-radius:14px; padding:3px;
            border:1px solid rgba(255,40,40,0.2);
            box-shadow: 0 0 20px rgba(255,30,30,0.08);
        }
        .tab-btn {
            flex:1; padding:9px 2px; border:none; border-radius:12px;
            background:transparent; color:#5a3a3a; font-weight:700; font-size:9px;
            cursor:pointer; transition: all 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
            letter-spacing:0.5px; text-transform:uppercase; font-family:'Orbitron', monospace;
        }
        .tab-btn.active {
            background:linear-gradient(180deg, #e02020, #7a0a0a);
            color:#fff;
            box-shadow:0 2px 20px rgba(255,30,30,0.6), inset 0 1px 0 rgba(255,255,255,0.2);
            transform: scale(1.02);
        }
        .tab-btn:active { transform: scale(0.96); }

        .tab-pane { display:none; }
        .tab-pane.active { display:block; animation: tabIn 0.4s cubic-bezier(0.34, 1.56, 0.64, 1); }
        @keyframes tabIn {
            0% { opacity:0; transform: translateY(10px) scale(0.98); }
            100% { opacity:1; transform: translateY(0) scale(1); }
        }

        .game-header-section {
            background: radial-gradient(circle at 30% 20%, rgba(255,120,120,0.15), rgba(20,4,4,0.7));
            border:1px solid rgba(255,100,100,0.3);
            border-radius:28px; padding:16px 18px; margin-bottom:14px;
            position:relative; z-index:1;
            -webkit-backdrop-filter: blur(18px); backdrop-filter: blur(18px);
            box-shadow:
                0 12px 40px rgba(0,0,0,0.5),
                0 0 30px rgba(255,30,30,0.15),
                0 0 60px rgba(255,30,30,0.06),
                inset 0 2px 6px rgba(255,150,150,0.12),
                inset 0 -3px 8px rgba(120,10,10,0.4);
            display:flex; align-items:center; gap:16px;
            transition: all 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
        }
        .game-header-section::before {
            content:''; position:absolute; top:8%; left:10%;
            width:36px; height:24px;
            background: radial-gradient(ellipse at center, rgba(255,255,255,0.3), rgba(255,255,255,0) 70%);
            border-radius:50%; filter: blur(2px); pointer-events:none;
        }
        .game-selector { flex:1; display:flex; flex-direction:column; gap:8px; }
        .game-option {
            padding:10px 14px; border-radius:16px;
            background: radial-gradient(circle at 30% 20%, rgba(255,120,120,0.15), rgba(15,3,3,0.85));
            border:1px solid rgba(255,80,80,0.25); color:#c89898;
            font-family:'Orbitron', monospace; font-size:11px; font-weight:700;
            letter-spacing:0.5px; cursor:pointer;
            transition: all 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
            display:flex; align-items:center; gap:8px; text-transform:uppercase;
            box-shadow: inset 0 1px 3px rgba(255,150,150,0.1), inset 0 -2px 5px rgba(120,10,10,0.3);
        }
        .game-option:active { transform: scale(0.96); }
        .game-option .icon-mini { color:#5a2a2a; font-size:13px; transition: 0.3s; }
        .game-option.selected {
            background: radial-gradient(circle at 30% 20%, rgba(255,150,150,0.4), rgba(180,10,10,0.9));
            border-color:#ff3333; color:#fff;
            box-shadow: 0 0 25px rgba(255,40,40,0.6), 0 0 50px rgba(255,40,40,0.25),
                inset 0 2px 6px rgba(255,200,200,0.25), inset 0 -3px 8px rgba(100,0,0,0.5);
        }
        .game-option.selected .icon-mini { color:#ffcccc; filter: drop-shadow(0 0 6px rgba(255,100,100,0.8)); }

        .progress-ring-wrap {
            position:relative; width:100px; height:100px; flex-shrink:0;
            display:flex; align-items:center; justify-content:center;
        }
        .ring-aura {
            position:absolute; inset:-14px; border-radius:50%;
            background: conic-gradient(from 0deg,
                rgba(255,30,30,0) 0deg, rgba(255,30,30,0) 270deg,
                rgba(255,60,60,0.5) 320deg, rgba(255,100,100,0.9) 350deg,
                rgba(255,150,150,1) 360deg);
            -webkit-mask: radial-gradient(circle, transparent 60%, black 62%, black 100%);
            mask: radial-gradient(circle, transparent 60%, black 62%, black 100%);
            animation: auraSpin 3s linear infinite;
            filter: blur(3px) drop-shadow(0 0 8px rgba(255,40,40,0.7));
            z-index:0; pointer-events:none;
        }
        .ring-aura-2 {
            position:absolute; inset:-10px; border-radius:50%;
            background: conic-gradient(from 180deg,
                rgba(255,30,30,0) 0deg, rgba(255,60,60,0.4) 300deg,
                rgba(255,120,120,0.8) 355deg, rgba(255,30,30,0) 360deg);
            -webkit-mask: radial-gradient(circle, transparent 65%, black 67%, black 100%);
            mask: radial-gradient(circle, transparent 65%, black 67%, black 100%);
            animation: auraSpin 4s linear infinite reverse;
            filter: blur(2px) drop-shadow(0 0 6px rgba(255,60,60,0.6));
            z-index:0; pointer-events:none;
        }
        @keyframes auraSpin { from { transform: rotate(0deg); } to { transform: rotate(360deg); } }
        .progress-ring-wrap svg {
            transform: rotate(-90deg); width:100px; height:100px;
            position:absolute; inset:0; z-index:2;
        }
        .ring-bg { fill:none; stroke: rgba(255,60,60,0.12); stroke-width:6; }
        .ring-progress {
            fill:none; stroke: url(#ringGradient); stroke-width:6; stroke-linecap: round;
            transition: stroke-dashoffset 0.7s cubic-bezier(0.34, 1.56, 0.64, 1);
            filter: drop-shadow(0 0 6px rgba(255,40,40,0.9)) drop-shadow(0 0 12px rgba(255,40,40,0.5));
        }
        .progress-text {
            position:relative; z-index:3;
            font-family:'Orbitron', monospace; font-size:18px; font-weight:900;
            color:#ff4444;
            text-shadow: 0 0 12px rgba(255,40,40,0.9), 0 0 24px rgba(255,40,40,0.5);
            transition: all 0.4s ease; letter-spacing:-0.5px;
        }
        .progress-text.max {
            color:#ffffff;
            text-shadow: 0 0 20px rgba(255,60,60,1), 0 0 40px rgba(255,60,60,0.8), 0 0 60px rgba(255,60,60,0.5);
            animation: textGlow 1.2s ease-in-out infinite;
        }
        @keyframes textGlow {
            0%,100% { text-shadow: 0 0 20px rgba(255,60,60,1), 0 0 40px rgba(255,60,60,0.8); }
            50% { text-shadow: 0 0 30px rgba(255,80,80,1), 0 0 60px rgba(255,60,60,0.9), 0 0 80px rgba(255,60,60,0.6); }
        }
        .progress-label {
            position:absolute; bottom:-18px; left:50%; transform: translateX(-50%);
            font-family:'Orbitron', monospace; font-size:7px; color:#7a3a3a;
            letter-spacing:1px; text-transform:uppercase; white-space:nowrap; z-index:3;
        }
        .ring-glow {
            position:absolute; inset:-4px; border-radius:50%;
            background: radial-gradient(circle, rgba(255,40,40,0.3) 0%, transparent 65%);
            animation: glowPulse 3s ease-in-out infinite; z-index:0; pointer-events:none;
        }
        @keyframes glowPulse {
            0%,100% { transform: scale(1); opacity:0.5; }
            50% { transform: scale(1.15); opacity:0.9; }
        }
        .progress-ring-wrap.maxed .ring-glow {
            background: radial-gradient(circle, rgba(255,60,60,0.6) 0%, transparent 65%);
            animation: glowPulseMax 1.2s ease-in-out infinite;
        }
        @keyframes glowPulseMax {
            0%,100% { transform: scale(1); opacity:0.8; }
            50% { transform: scale(1.25); opacity:1; }
        }
        .particle {
            position:absolute; width:4px; height:4px; background:#ff3333;
            border-radius:50%; box-shadow: 0 0 8px rgba(255,40,40,1);
            pointer-events:none; z-index:0;
        }
        .particle.spark { animation: sparkFly 1s ease-out forwards; }
        @keyframes sparkFly {
            0% { transform: translate(0,0) scale(1); opacity:1; }
            100% { transform: translate(var(--tx), var(--ty)) scale(0); opacity:0; }
        }

        .func-list {
            display:flex; flex-direction:column; gap:12px; margin:6px 0 10px;
            position:relative; z-index:1;
        }
        .func-row {
            background: radial-gradient(circle at 25% 20%, rgba(255,120,120,0.25) 0%, rgba(200,30,30,0.15) 25%, rgba(20,4,4,0.7) 70%);
            border:1px solid rgba(255,120,120,0.3); border-radius:32px;
            padding:14px 18px; position:relative; overflow:hidden;
            -webkit-backdrop-filter: blur(18px) saturate(180%);
            backdrop-filter: blur(18px) saturate(180%);
            box-shadow:
                0 12px 40px rgba(0,0,0,0.5),
                0 0 20px rgba(255,30,30,0.12),
                0 0 0 1px rgba(255,60,60,0.1),
                inset 0 2px 8px rgba(255,150,150,0.18),
                inset 0 -4px 12px rgba(120,10,10,0.4),
                inset 0 0 60px rgba(255,40,40,0.08);
            transition: all 0.5s cubic-bezier(0.34, 1.56, 0.64, 1);
        }
        .func-row::before {
            content:''; position:absolute; top:8%; left:12%;
            width:32px; height:22px;
            background: radial-gradient(ellipse at center, rgba(255,255,255,0.4), rgba(255,255,255,0) 70%);
            border-radius:50%; filter: blur(2px); pointer-events:none; z-index:0;
        }
        .func-row::after {
            content:''; position:absolute; top:22%; left:8%;
            width:10px; height:7px;
            background: radial-gradient(ellipse at center, rgba(255,255,255,0.3), rgba(255,255,255,0) 70%);
            border-radius:50%; filter: blur(1px); pointer-events:none; z-index:0;
        }
        .func-row:hover {
            border-color: rgba(255,120,120,0.5); transform: translateY(-2px);
            box-shadow:
                0 16px 50px rgba(0,0,0,0.6),
                0 0 35px rgba(255,30,30,0.2),
                inset 0 2px 8px rgba(255,150,150,0.2),
                inset 0 -4px 12px rgba(120,10,10,0.4);
        }
        .func-row.active {
            background: radial-gradient(circle at 25% 20%, rgba(255,150,150,0.4) 0%, rgba(255,50,50,0.25) 30%, rgba(40,4,4,0.8) 75%);
            border-color: rgba(255,100,100,0.7);
            box-shadow:
                0 0 50px rgba(255,40,40,0.45),
                0 0 100px rgba(255,30,30,0.2),
                0 12px 40px rgba(0,0,0,0.6),
                inset 0 2px 8px rgba(255,180,180,0.3),
                inset 0 -4px 12px rgba(150,10,10,0.5),
                inset 0 0 80px rgba(255,60,60,0.15);
        }
        .func-header {
            display:flex; justify-content:space-between; align-items:center;
            position:relative; z-index:1;
        }
        .func-row .label {
            font-size:12px; font-weight:700; color:#e8d8d8; letter-spacing:0.5px;
            display:flex; align-items:center; gap:10px;
            text-transform:uppercase; font-family:'Orbitron', monospace;
            text-shadow: 0 1px 3px rgba(0,0,0,0.6);
        }
        .led {
            width:8px; height:8px; border-radius:50%;
            background:#3a1010; box-shadow: inset 0 0 4px rgba(0,0,0,0.8);
            transition: all 0.4s ease; flex-shrink:0; position:relative;
        }
        .led::after {
            content:''; position:absolute; inset:-2px; border-radius:50%;
            background: transparent; transition: all 0.4s ease;
        }
        .func-row.active .led {
            background:#ff2222;
            box-shadow: 0 0 12px rgba(255,30,30,0.9), 0 0 24px rgba(255,30,30,0.6), inset 0 0 4px rgba(255,150,150,0.8);
            animation: ledPulse 1.5s ease-in-out infinite;
        }
        .func-row.active .led::after {
            background: radial-gradient(circle, rgba(255,40,40,0.4), transparent 70%);
            animation: ledRing 1.5s ease-out infinite;
        }
        @keyframes ledPulse { 0%,100% { opacity:1; } 50% { opacity:0.6; } }
        @keyframes ledRing { 0% { transform: scale(1); opacity:0.8; } 100% { transform: scale(2.2); opacity:0; } }
        .func-row .label .icon {
            font-size:14px; color:#5a2a2a; transition: all 0.4s ease;
        }
        .func-row.active .label .icon {
            color:#ff3333; filter: drop-shadow(0 0 8px rgba(255,40,40,0.8));
        }

        .toggle-switch {
            width:46px; height:26px; background: rgba(0,0,0,0.6);
            border-radius:30px; cursor:pointer; position:relative;
            transition: all 0.45s cubic-bezier(0.34, 1.56, 0.64, 1);
            border:1px solid rgba(255,40,40,0.3);
            flex-shrink:0; box-shadow: inset 0 2px 6px rgba(0,0,0,0.6);
        }
        .toggle-switch:active { transform: scale(0.92); }
        .toggle-switch.active {
            background: linear-gradient(180deg, #e02020, #7a0a0a);
            border-color:#ff3333;
            box-shadow: 0 0 25px rgba(255,40,40,0.7), 0 0 50px rgba(255,40,40,0.3),
                inset 0 2px 6px rgba(0,0,0,0.4);
        }
        .toggle-switch .slider {
            width:18px; height:18px;
            background: linear-gradient(180deg, #7a5a5a, #4a2a2a);
            border-radius:50%; position:absolute; top:3px; left:3px;
            transition: all 0.45s cubic-bezier(0.34, 1.56, 0.64, 1);
            box-shadow: 0 2px 8px rgba(0,0,0,0.5);
        }
        .toggle-switch.active .slider {
            left:23px;
            background: linear-gradient(180deg, #ffffff, #ffcccc);
            box-shadow: 0 0 20px rgba(255,60,60,0.9), 0 2px 8px rgba(0,0,0,0.5);
        }

        .func-slider-wrap {
            max-height:0; opacity:0; overflow:hidden;
            transition: all 0.5s cubic-bezier(0.34, 1.56, 0.64, 1);
            position:relative; z-index:1;
        }
        .func-slider-wrap.show {
            max-height:80px; opacity:1; margin-top:12px; padding-top:12px;
            border-top:1px solid rgba(255,80,80,0.2);
        }
        .func-slider-header {
            display:flex; justify-content:space-between; align-items:center;
            font-size:10px; color:#a06a6a; margin-bottom:8px;
            text-transform:uppercase; letter-spacing:0.8px;
            font-family:'Orbitron', monospace;
        }
        .func-slider-header .val {
            font-family:'Orbitron', monospace; font-size:14px; font-weight:700;
            color:#ff4444; text-shadow: 0 0 12px rgba(255,40,40,0.8);
            transition: all 0.2s ease;
        }
        .func-slider-header .val.max {
            color:#ff6666;
            text-shadow: 0 0 20px rgba(255,60,60,1), 0 0 40px rgba(255,60,60,0.6);
            animation: valPulse 0.6s ease;
        }
        @keyframes valPulse {
            0% { transform: scale(1); }
            50% { transform: scale(1.3); }
            100% { transform: scale(1); }
        }
        .func-slider-wrap input[type="range"] {
            width:100%; -webkit-appearance:none;
            background: rgba(0,0,0,0.5); height:5px;
            border-radius:10px; outline:none;
            box-shadow: inset 0 1px 3px rgba(0,0,0,0.8); cursor:pointer;
        }
        .func-slider-wrap input[type="range"]::-webkit-slider-thumb {
            -webkit-appearance:none; width:22px; height:22px; border-radius:50%;
            background: radial-gradient(circle at 30% 30%, #ff7777 0%, #e02020 40%, #7a0a0a 100%);
            cursor:pointer;
            box-shadow:
                0 0 20px rgba(255,40,40,0.9), 0 0 40px rgba(255,40,40,0.5),
                0 2px 8px rgba(0,0,0,0.6),
                inset 0 2px 4px rgba(255,200,200,0.5),
                inset 0 -2px 6px rgba(80,0,0,0.6);
            border:1px solid rgba(255,150,150,0.6);
            transition: transform 0.2s ease;
        }
        .bubble-max .func-slider-wrap input[type="range"]::-webkit-slider-thumb {
            animation: bubblePop 0.6s cubic-bezier(0.34, 1.56, 0.64, 1);
            background: radial-gradient(circle at 30% 30%, #ffffff 0%, #ff5555 30%, #e02020 60%, #7a0a0a 100%);
            box-shadow: 0 0 30px rgba(255,60,60,1), 0 0 60px rgba(255,40,40,0.7),
                0 0 100px rgba(255,40,40,0.4),
                inset 0 3px 6px rgba(255,255,255,0.6),
                inset 0 -3px 8px rgba(80,0,0,0.7);
        }
        @keyframes bubblePop {
            0% { transform: scale(1); } 30% { transform: scale(1.5); }
            50% { transform: scale(0.9); } 70% { transform: scale(1.2); }
            100% { transform: scale(1); }
        }
        @keyframes bubbleShake {
            0% { transform: scale(1); }
            25% { transform: scale(1.06) rotate(-0.5deg); }
            50% { transform: scale(0.98) rotate(0.5deg); }
            75% { transform: scale(1.03); }
            100% { transform: scale(1); }
        }

        .monitor-section {
            background: radial-gradient(circle at 25% 20%, rgba(255,120,120,0.2), rgba(20,4,4,0.65));
            border:1px solid rgba(255,120,120,0.25); border-radius:24px;
            padding:12px; margin:8px 0 10px;
            -webkit-backdrop-filter: blur(18px); backdrop-filter: blur(18px);
            position:relative; z-index:1;
            box-shadow: 0 8px 32px rgba(0,0,0,0.5), 0 0 25px rgba(255,30,30,0.1),
                inset 0 2px 6px rgba(255,150,150,0.12),
                inset 0 -3px 8px rgba(120,10,10,0.35);
        }
        .monitor-row { display:flex; gap:14px; justify-content:space-around; align-items:center; }
        .monitor-item { text-align:center; flex:1; }
        .monitor-item .label {
            font-size:8px; color:#8a4a4a; text-transform:uppercase;
            letter-spacing:0.8px; font-family:'Orbitron', monospace;
        }
        .monitor-item .value {
            font-family:'Orbitron',monospace; font-size:18px; font-weight:700;
            color:#ff4444; margin-top:2px;
            text-shadow: 0 0 20px rgba(255,40,40,0.6);
        }
        .temp-bar-wrap {
            margin-top:6px; height:5px; background:rgba(0,0,0,0.7);
            border-radius:10px; overflow:hidden; position:relative;
            box-shadow: inset 0 1px 3px rgba(0,0,0,0.8);
        }
        .temp-bar {
            height:100%; width:0%; border-radius:10px;
