    function consoleLog(consoleId, msg, type = '') {
        const el = document.getElementById(consoleId + '-body') || document.getElementById(consoleId);
        if (!el) return;
        const line = document.createElement('div');
        line.className = 'line';
        let colorClass = 'dim';
        if (type === 'success') colorClass = 'success';
        else if (type === 'warn') colorClass = 'warn';
        else if (type === 'info') colorClass = 'info';
        else if (type === 'highlight') colorClass = 'highlight';
        else if (type === 'antiban') colorClass = 'antiban';
        else if (type === 'version') colorClass = 'version';
        line.innerHTML = `<span class="prompt">$</span> <span class="${colorClass}">${msg}</span>`;
        el.appendChild(line);
        el.scrollTop = el.scrollHeight;
        while (el.children.length > 60) el.removeChild(el.firstChild);
    }

    function runCodeSequence(consoleId) {
        const el = document.getElementById(consoleId + '-body') || document.getElementById(consoleId);
        if (!el) return;
        const oldCursor = el.querySelector('.cursor');
        if (oldCursor) oldCursor.remove();
        let i = 0;
        const maxLines = 40;
        const interval = setInterval(() => {
            if (i >= maxLines) {
                clearInterval(interval);
                const cursorLine = document.createElement('div');
                cursorLine.className = 'line';
                cursorLine.innerHTML = `<span class="prompt">$</span> <span class="dim">idle</span><span class="cursor"></span>`;
                el.appendChild(cursorLine);
                el.scrollTop = el.scrollHeight;
                return;
            }
            const line = CODE_POOL[Math.floor(Math.random() * CODE_POOL.length)];
            let type = '';
            if (line.includes('[OK]') || line.includes('online') || line.includes('start')) type = 'success';
            else if (line.includes('function:')) type = 'highlight';
            else if (line.includes('>')) type = 'info';
            consoleLog(consoleId, line.replace(/^>\s*/, ''), type);
            i++;
        }, 45);
    }

