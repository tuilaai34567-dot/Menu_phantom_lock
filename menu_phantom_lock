        const consoleId = 'console' + target;

        if (c === 'phantom_version') {
            consoleLog(consoleId, 'VERSION: 3.0', 'version');
            playBubbleOn(60);
            vibrate([15, 25, 15]);
            return;
        }

        if (c === 'phantom_antiban_buff') {
            playBubbleOn(80);
            vibrate([20, 30, 20, 30, 40]);
            runCodeSequence(consoleId);
            setTimeout(() => {
                consoleLog(consoleId, 'ANTIBAN: ON', 'antiban');
                playTing();
            }, 2200);
            return;
        }

        if (c === 'phantom_clear_memory') {
            const el = document.getElementById('console2-body');
            if (el) el.innerHTML = '<div class="line"><span class="prompt">$</span> <span class="dim">memory cleared</span><span class="cursor"></span></div>';
            playBubbleOff();
            vibrate([20, 40, 20]);
            return;
        }

        if (c === 'phantom_clear_console') {
            const el = document.getElementById('console1-body');
            if (el) el.innerHTML = '<div class="line"><span class="prompt">$</span> <span class="dim">console cleared</span><span class="cursor"></span></div>';
            playBubbleOff();
            vibrate([20, 40, 20]);
            return;
        }

        consoleLog(consoleId, `[ERR] unknown command: ${cmd}`, 'warn');
        playBubbleOff();
        vibrate([20, 40, 20]);
    }

    [1, 2].forEach(n => {
        const input = document.getElementById('cmdInput' + n);
        const btn = document.querySelector(`.cmd-send[data-target="${n}"]`);
        if (input) {
            input.addEventListener('keydown', function(e) {
                if (e.key === 'Enter') {
                    const cmd = this.value.trim();
                    if (cmd) {
                        consoleLog('console' + n, `> ${cmd}`, 'info');
                        handleCommand(cmd, n);
                        this.value = '';
                    }
                }
            });
        }
        if (btn) {
            btn.addEventListener('click', function() {
                const cmd = input.value.trim();
                if (cmd) {
                    consoleLog('console' + n, `> ${cmd}`, 'info');
                    handleCommand(cmd, n);
                    input.value = '';
                }
            });
        }
    });

    // ============================================================
    // GAME SELECTOR
    // ============================================================
    document.querySelectorAll('.game-option').forEach(opt => {
        opt.addEventListener('click', function() {
            document.querySelectorAll('.game-option').forEach(o => o.classList.remove('selected'));
            this.classList.add('selected');
            playBubbleOn(50); vibrate(20);
            const game = this.dataset.game;
            consoleLog('console1', `[OK] target: ${game === 'ff' ? 'Free Fire' : 'Free Fire Max'}`, 'success');
        });
    });

    // ============================================================
    // TABS
    // ============================================================
    document.querySelectorAll('.tab-btn').forEach(btn => {
        btn.addEventListener('click', function() {
            document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
            this.classList.add('active');
            const target = this.dataset.tab;
            document.querySelectorAll('.tab-pane').forEach(p => p.classList.remove('active'));
            document.getElementById(target).classList.add('active');
            playBubbleOn(30); vibrate(10);
        });
    });

    // ============================================================
    // TOGGLE
    // ============================================================
    document.querySelectorAll('.toggle-switch[data-toggle]').forEach(toggle => {
        toggle.addEventListener('click', function(e) {
            e.stopPropagation();
            const isActive = this.classList.contains('active');
            const row = this.closest('.func-row');
            const sliderWrap = row.querySelector('.func-slider-wrap');
            const slider = row.querySelector('input[type="range"]');
            const valEl = row.querySelector('.func-slider-header .val');
            const label = row.dataset.func || row.dataset.opt || 'Unknown';
            const consoleId = row.closest('.tab-pane')?.id === 'tab1' ? 'console1' : 'console2';
            const isTab1 = row.closest('.tab-pane')?.id === 'tab1';

            if (isActive) {
                this.classList.remove('active');
                row.classList.remove('active');
                if (sliderWrap) sliderWrap.classList.remove('show');
                if (slider) slider.value = 1;
                if (valEl) { valEl.textContent = '0%'; valEl.classList.remove('max'); }
                consoleLog(consoleId, `[OFF] ${label}`, 'warn');
                playBubbleOff();
                vibrate([15, 30, 15]);
                if (isTab1) updateProgressRing();
            } else {
                this.classList.add('active');
                row.classList.add('active');
                vibrate([10, 20, 30]);
                row.style.transform = 'scale(1.04)';
                setTimeout(() => { row.style.transform = ''; }, 200);
                setTimeout(() => {
                    if (sliderWrap) sliderWrap.classList.add('show');
                    if (slider) slider.value = 1;
                    if (valEl) valEl.textContent = '1%';
                }, 120);
                playBubbleOn(70);
                runCodeSequence(consoleId);
                if (isTab1) updateProgressRing();
            }
        });
    });

    // ============================================================
    // SLIDER
    // ============================================================
    document.querySelectorAll('.func-slider-wrap input[type="range"]').forEach(slider => {
        const valEl = slider.closest('.func-slider-wrap').querySelector('.func-slider-header .val');
        const row = slider.closest('.func-row');
        let wasMax = false;
        let lastVibrateVal = 0;
        let lastSoundVal = 0;

        slider.addEventListener('input', function() {
            const val = parseInt(this.value);
            if (valEl) valEl.textContent = val + '%';
            if (Math.abs(val - lastSoundVal) >= 5) {
                playSliderSound(val);
                lastSoundVal = val;
            }
            if (Math.abs(val - lastVibrateVal) >= 8) {
                vibrate(Math.min(30, 5 + Math.floor(val / 5)));
                lastVibrateVal = val;
            }
            if (val >= 100 && !wasMax) {
                wasMax = true;
                if (valEl) valEl.classList.add('max');
                row.classList.add('bubble-max');
                playTing();
                vibrate([30, 20, 60, 20, 100]);
                row.style.animation = 'bubbleShake 0.5s cubic-bezier(0.34, 1.56, 0.64, 1)';
                setTimeout(() => {
                    row.style.animation = '';
                    row.classList.remove('bubble-max');
                }, 700);
            } else if (val < 100) {
                wasMax = false;
                if (valEl) valEl.classList.remove('max');
            }
        });
        slider.addEventListener('change', function() { vibrate(20); });
    });

    // ============================================================
    // MONITOR
    // ============================================================
    let cpuOptActive = false;
    let fpsLockActive = false;
    document.querySelectorAll('#optList .toggle-switch[data-toggle]').forEach(toggle => {
        const row = toggle.closest('.func-row');
        const label = row ? row.dataset.opt : '';
        toggle.addEventListener('click', function(e) {
            if (label === 'tối ưu cpu') cpuOptActive = this.classList.contains('active');
            if (label === 'lock fps') fpsLockActive = this.classList.contains('active');
        });
    });

    const cpuTempEl = document.getElementById('cpuTemp');
    const cpuBar = document.getElementById('cpuBar');
    const fpsDisplay = document.getElementById('fpsDisplay');
    const fpsBars = document.querySelectorAll('#fpsWifi .bar');

    function updateMonitor() {
        let temp = 30 + Math.random() * 40;
        if (cpuOptActive) temp = Math.min(38, 20 + Math.random() * 18);
        const tempRounded = Math.round(temp);
        cpuTempEl.textContent = tempRounded + '°C';
        cpuBar.style.width = temp + '%';
        let color;
        if (temp > 70) color = '#ef4444';
        else if (temp > 50) color = '#fbbf24';
        else color = '#22c55e';
        cpuBar.style.background = color;

        let fps = fpsLockActive ? 90 : 50 + Math.floor(Math.random() * 30);
        fpsDisplay.textContent = fps;
        const levels = Math.floor(fps / 10);
        fpsBars.forEach((bar, idx) => {
            if (idx < levels) {
                bar.classList.add('active');
                bar.style.height = (8 + idx * 5) + 'px';
            } else {
                bar.classList.remove('active');
                bar.style.height = '5px';
            }
        });
    }
    setInterval(updateMonitor, 1400);
    updateMonitor();

    // ============================================================
    // INJECT
    // ============================================================
    const fileInput = document.getElementById('fileInput');
    const injectBtn = document.getElementById('injectBtn');
    const fileInfo = document.getElementById('fileInfo');
    const gameModal = document.getElementById('gameModal');
    let uploadedFile = null;

    fileInput.addEventListener('change', function(e) {
        const file = this.files[0];
        if (!file) return;
        const ext = file.name.split('.').pop().toLowerCase();
        const blocked = ['zip','png','jpg','jpeg','gif','bmp','webp','mp4','avi','mov','mkv'];
        if (blocked.includes(ext)) {
            consoleLog('console3', `[ERR] unsupported format .${ext}`, 'warn');
            playBubbleOff(); vibrate([20, 40, 20]);
            fileInput.value = '';
            return;
        }
        uploadedFile = file;
        fileInfo.innerHTML = '';
        const d1 = document.createElement('div');
        d1.className = 'item';
        d1.innerHTML = `<span class="name">${file.name}</span>`;
        fileInfo.appendChild(d1);
        consoleLog('console3', `[OK] payload loaded: ${file.name}`, 'success');
        playBubbleOn(70); vibrate(30);
    });

    injectBtn.addEventListener('click', function() {
        if (!uploadedFile) {
            consoleLog('console3', '[WARN] no payload loaded', 'warn');
            playBubbleOff(); vibrate([20, 40, 20]);
            return;
        }
        playBubbleOn(60); vibrate([15, 25, 15]);
        gameModal.classList.add('active');
        consoleLog('console3', '[INFO] choose app to inject', 'info');
    });

    document.querySelectorAll('.game-modal-btn').forEach(btn => {
        btn.addEventListener('click', function() {
            const target = this.dataset.target;
            gameModal.classList.remove('active');
            playBubbleOn(80);
            vibrate([20, 30, 20, 30, 40]);
            const gameName = target === 'ff' ? 'Free Fire' : 'Free Fire Max';
            consoleLog('console3', `[OK] target: ${gameName}`, 'success');
            setTimeout(() => runCodeSequence('console3'), 200);
            setTimeout(() => {
                consoleLog('console3', '[OK] injected into game data successfully', 'highlight');
                playTing();
                vibrate([30, 20, 60, 20, 100]);
            }, 2500);
        });
    });

    gameModal.addEventListener('click', function(e) {
        if (e.target === this) {
            this.classList.remove('active');
            playBubbleOff();
        }
    });

    // ============================================================
    // GAME BUTTONS
    // ============================================================
    document.getElementById('openFF').addEventListener('click', function() {
        playBubbleOn(60); vibrate([10, 20, 30]);
        runCodeSequence('console4');
        setTimeout(() => {
            try { window.location.href = 'freefireth://'; } catch(e) { consoleLog('console4', '[ERR] launch failed', 'warn'); }
        }, 1200);
    });
    document.getElementById('openFFMax').addEventListener('click', function() {
        playBubbleOn(60); vibrate([10, 20, 30]);
        runCodeSequence('console4');
        setTimeout(() => {
            try { window.location.href = 'freefiremax://'; } catch(e) { consoleLog('console4', '[ERR] launch failed', 'warn'); }
        }, 1200);
    });

    // ============================================================
    // SOCIAL
    // ============================================================
    document.querySelectorAll('.social-btn').forEach(btn => {
        btn.addEventListener('click', function() {
            const url = this.dataset.url;
            playBubbleOn(70); vibrate([15, 25, 15]);
            if (url) {
                try { window.open(url, '_blank'); } catch(e) {
                    try { window.location.href = url; } catch(e2) {}
                }
            }
        });
    });

    document.body.addEventListener('touchstart', initAudio, { once: true });
    document.body.addEventListener('click', initAudio, { once: true });
</script>
</body>
</html>
