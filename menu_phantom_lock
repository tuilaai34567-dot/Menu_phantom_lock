<script>
    // ============================================================
    // AUDIO
    // ============================================================
    let audioCtx = null;
    function initAudio() {
        if (!audioCtx) {
            try { audioCtx = new (window.AudioContext || window.webkitAudioContext)(); } catch(e) {}
        }
        if (audioCtx && audioCtx.state === 'suspended') audioCtx.resume();
        return audioCtx;
    }

    function playBubbleOn(strength = 50) {
        const ctx = initAudio();
        if (!ctx) return;
        try {
            const now = ctx.currentTime;
            const s = Math.min(100, Math.max(1, strength)) / 100;

            const sub = ctx.createOscillator();
            const subGain = ctx.createGain();
            sub.connect(subGain); subGain.connect(ctx.destination);
            sub.frequency.setValueAtTime(90, now);
            sub.frequency.exponentialRampToValueAtTime(45, now + 0.15);
            sub.type = 'sine';
            subGain.gain.setValueAtTime(0, now);
            subGain.gain.linearRampToValueAtTime(0.14 + s * 0.04, now + 0.008);
            subGain.gain.exponentialRampToValueAtTime(0.001, now + 0.28);
            sub.start(now); sub.stop(now + 0.3);

            const click = ctx.createOscillator();
            const clickGain = ctx.createGain();
            click.connect(clickGain); clickGain.connect(ctx.destination);
            click.frequency.setValueAtTime(1800, now);
            click.frequency.exponentialRampToValueAtTime(600, now + 0.04);
            click.type = 'triangle';
            clickGain.gain.setValueAtTime(0, now);
            clickGain.gain.linearRampToValueAtTime(0.07, now + 0.003);
            clickGain.gain.exponentialRampToValueAtTime(0.001, now + 0.07);
            click.start(now); click.stop(now + 0.08);

            const tone = ctx.createOscillator();
            const toneGain = ctx.createGain();
            tone.connect(toneGain); toneGain.connect(ctx.destination);
            const baseFreq = 400 + s * 300;
            tone.frequency.setValueAtTime(baseFreq * 0.6, now);
            tone.frequency.exponentialRampToValueAtTime(baseFreq * 1.4, now + 0.09);
            tone.frequency.exponentialRampToValueAtTime(baseFreq, now + 0.18);
            tone.type = 'sine';
            toneGain.gain.setValueAtTime(0, now);
            toneGain.gain.linearRampToValueAtTime(0.11 + s * 0.03, now + 0.012);
            toneGain.gain.exponentialRampToValueAtTime(0.001, now + 0.35);
            tone.start(now); tone.stop(now + 0.38);

            const harm1 = ctx.createOscillator();
            const harm1Gain = ctx.createGain();
            harm1.connect(harm1Gain); harm1Gain.connect(ctx.destination);
            harm1.frequency.setValueAtTime(baseFreq * 1.5, now + 0.015);
            harm1.type = 'sine';
            harm1Gain.gain.setValueAtTime(0, now);
            harm1Gain.gain.linearRampToValueAtTime(0.05 + s * 0.015, now + 0.03);
            harm1Gain.gain.exponentialRampToValueAtTime(0.001, now + 0.3);
            harm1.start(now + 0.015); harm1.stop(now + 0.33);

            const harm2 = ctx.createOscillator();
            const harm2Gain = ctx.createGain();
            harm2.connect(harm2Gain); harm2Gain.connect(ctx.destination);
            harm2.frequency.setValueAtTime(baseFreq * 2, now + 0.03);
            harm2.type = 'sine';
            harm2Gain.gain.setValueAtTime(0, now);
            harm2Gain.gain.linearRampToValueAtTime(0.028 + s * 0.01, now + 0.045);
            harm2Gain.gain.exponentialRampToValueAtTime(0.001, now + 0.25);
            harm2.start(now + 0.03); harm2.stop(now + 0.28);

            const tail = ctx.createOscillator();
            const tailGain = ctx.createGain();
            tail.connect(tailGain); tailGain.connect(ctx.destination);
            tail.frequency.setValueAtTime(baseFreq * 0.75, now + 0.1);
            tail.type = 'sine';
            tailGain.gain.setValueAtTime(0, now);
            tailGain.gain.linearRampToValueAtTime(0.025, now + 0.12);
            tailGain.gain.exponentialRampToValueAtTime(0.001, now + 0.8);
            tail.start(now + 0.1); tail.stop(now + 0.85);

            if (s > 0.3) {
                const shimmer = ctx.createOscillator();
                const shimmerGain = ctx.createGain();
                shimmer.connect(shimmerGain); shimmerGain.connect(ctx.destination);
                shimmer.frequency.setValueAtTime(3200, now + 0.05);
                shimmer.frequency.exponentialRampToValueAtTime(2800, now + 0.3);
                shimmer.type = 'sine';
                shimmerGain.gain.setValueAtTime(0, now);
                shimmerGain.gain.linearRampToValueAtTime(0.012 * s, now + 0.07);
                shimmerGain.gain.exponentialRampToValueAtTime(0.001, now + 0.5);
                shimmer.start(now + 0.05); shimmer.stop(now + 0.55);
            }
        } catch(e) {}
    }

    function playBubbleOff() {
        const ctx = initAudio(); if (!ctx) return;
        try {
            const now = ctx.currentTime;
            const baseFreq = 380;
            const osc = ctx.createOscillator(); const gain = ctx.createGain();
            osc.connect(gain); gain.connect(ctx.destination);
            osc.frequency.setValueAtTime(baseFreq, now);
            osc.frequency.exponentialRampToValueAtTime(baseFreq * 0.6, now + 0.08);
            osc.type = 'sine';
            gain.gain.setValueAtTime(0, now);
            gain.gain.linearRampToValueAtTime(0.06, now + 0.005);
            gain.gain.exponentialRampToValueAtTime(0.001, now + 0.2);
            osc.start(now); osc.stop(now + 0.24);
        } catch(e) {}
    }

    function playTing() {
        const ctx = initAudio();
        if (!ctx) return;
        try {
            const now = ctx.currentTime;
            const osc1 = ctx.createOscillator();
            const gain1 = ctx.createGain();
            osc1.connect(gain1); gain1.connect(ctx.destination);
            osc1.frequency.setValueAtTime(880, now);
            osc1.frequency.exponentialRampToValueAtTime(876, now + 0.5);
            osc1.type = 'sine';
            gain1.gain.setValueAtTime(0, now);
            gain1.gain.linearRampToValueAtTime(0.06, now + 0.015);
            gain1.gain.exponentialRampToValueAtTime(0.001, now + 1.6);
            osc1.start(now); osc1.stop(now + 1.7);

            const osc2 = ctx.createOscillator();
            const gain2 = ctx.createGain();
            osc2.connect(gain2); gain2.connect(ctx.destination);
            osc2.frequency.setValueAtTime(1320, now + 0.02);
            osc2.type = 'sine';
            gain2.gain.setValueAtTime(0, now);
            gain2.gain.linearRampToValueAtTime(0.035, now + 0.03);
            gain2.gain.exponentialRampToValueAtTime(0.001, now + 1.2);
            osc2.start(now + 0.02); osc2.stop(now + 1.3);

            const osc3 = ctx.createOscillator();
            const gain3 = ctx.createGain();
            osc3.connect(gain3); gain3.connect(ctx.destination);
            osc3.frequency.setValueAtTime(1760, now + 0.04);
            osc3.type = 'sine';
            gain3.gain.setValueAtTime(0, now);
            gain3.gain.linearRampToValueAtTime(0.018, now + 0.05);
            gain3.gain.exponentialRampToValueAtTime(0.001, now + 0.9);
            osc3.start(now + 0.04); osc3.stop(now + 1.0);

            const osc4 = ctx.createOscillator();
            const gain4 = ctx.createGain();
            osc4.connect(gain4); gain4.connect(ctx.destination);
            osc4.frequency.setValueAtTime(220, now);
            osc4.type = 'sine';
            gain4.gain.setValueAtTime(0, now);
            gain4.gain.linearRampToValueAtTime(0.025, now + 0.02);
            gain4.gain.exponentialRampToValueAtTime(0.001, now + 0.4);
            osc4.start(now); osc4.stop(now + 0.5);

            const osc5 = ctx.createOscillator();
            const gain5 = ctx.createGain();
            osc5.connect(gain5); gain5.connect(ctx.destination);
            osc5.frequency.setValueAtTime(2637, now + 0.06);
            osc5.type = 'sine';
            gain5.gain.setValueAtTime(0, now);
            gain5.gain.linearRampToValueAtTime(0.008, now + 0.08);
            gain5.gain.exponentialRampToValueAtTime(0.001, now + 2.0);
            osc5.start(now + 0.06); osc5.stop(now + 2.1);
        } catch(e) {}
    }

    function playSliderSound(value) {
        const ctx = initAudio(); if (!ctx) return;
        try {
            const now = ctx.currentTime;
            const t = value / 100;
            const baseFreq = 250 + t * 550;
            const volume = 0.015 + t * 0.05;
            const osc = ctx.createOscillator(); const gain = ctx.createGain();
            osc.connect(gain); gain.connect(ctx.destination);
            osc.frequency.setValueAtTime(baseFreq, now);
            osc.frequency.linearRampToValueAtTime(baseFreq * 1.05, now + 0.05);
            osc.type = 'sine';
            gain.gain.setValueAtTime(0, now);
            gain.gain.linearRampToValueAtTime(volume, now + 0.008);
            gain.gain.exponentialRampToValueAtTime(0.001, now + 0.1);
            osc.start(now); osc.stop(now + 0.12);
            const osc2 = ctx.createOscillator(); const gain2 = ctx.createGain();
            osc2.connect(gain2); gain2.connect(ctx.destination);
            osc2.frequency.setValueAtTime(baseFreq * 1.5, now + 0.005);
            osc2.type = 'triangle';
            gain2.gain.setValueAtTime(0, now);
            gain2.gain.linearRampToValueAtTime(volume * 0.3, now + 0.01);
            gain2.gain.exponentialRampToValueAtTime(0.001, now + 0.08);
            osc2.start(now + 0.005); osc2.stop(now + 0.1);
        } catch(e) {}
    }
    function vibrate(pattern) {
        if (navigator.vibrate) { try { navigator.vibrate(pattern); } catch(e) {} }
    }

    // ============================================================
    // PROGRESS RING
    // ============================================================
    const RING_CIRCUMFERENCE = 2 * Math.PI * 42;
    const ringProgress = document.getElementById('ringProgress');
    const progressText = document.getElementById('progressText');
    const ringWrap = document.getElementById('ringWrap');
    const TOTAL_FUNCS = document.querySelectorAll('#funcList .func-row').length;

    function updateProgressRing() {
        const activeCount = document.querySelectorAll('#funcList .func-row.active').length;
        const percent = Math.round((activeCount / TOTAL_FUNCS) * 100);
        const offset = RING_CIRCUMFERENCE - (RING_CIRCUMFERENCE * percent / 100);
        ringProgress.style.strokeDashoffset = offset;
        progressText.textContent = percent + '%';
        if (percent === 100) {
            if (!ringWrap.classList.contains('maxed')) {
                ringWrap.classList.add('maxed');
                progressText.classList.add('max');
                playTing();
                vibrate([30, 20, 60, 20, 100, 20, 150]);
                spawnParticles();
            }
        } else {
            ringWrap.classList.remove('maxed');
            progressText.classList.remove('max');
        }
    }
    function spawnParticles() {
        const count = 12;
        for (let i = 0; i < count; i++) {
            const p = document.createElement('div');
            p.className = 'particle spark';
            const angle = (i / count) * Math.PI * 2;
            const dist = 50 + Math.random() * 30;
            p.style.setProperty('--tx', Math.cos(angle) * dist + 'px');
            p.style.setProperty('--ty', Math.sin(angle) * dist + 'px');
            p.style.left = '48px'; p.style.top = '48px';
            p.style.animationDelay = (i * 0.03) + 's';
            ringWrap.appendChild(p);
            setTimeout(() => p.remove(), 1400);
        }
    }

